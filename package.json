{
  "name": "@dcl/catalyst-storage",
  "version": "1.0.0",
  "description": "Storage component for catalysts (WKC)",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "lint:check": "eslint '**/*.{js,ts}'",
    "lint:fix": "eslint '**/*.{js,ts}' --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --verbose",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --verbose",
    "prepublishOnly": "yarn build && yarn lint:check && yarn test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentraland/catalyst-storage.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/decentraland/catalyst-storage/issues"
  },
  "homepage": "https://github.com/decentraland/catalyst-storage#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/lib-storage": "^3.1095.0",
    "@well-known-components/interfaces": "^1.5.2",
    "destroy": "^1.2.0",
    "file-type": "^22.0.1"
  },
  "devDependencies": {
    "@dcl/eslint-config": "^3.1.0",
    "@types/destroy": "^1.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@well-known-components/env-config-provider": "^1.2.0",
    "@well-known-components/logger": "^3.1.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.4.2",
    "prettier": "^3.4.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "tabWidth": 2
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  }
}
